{
  "name": "@payloadcms/engine-rs",
  "version": "4.0.0-beta.6",
  "description": "Rust implementation of the Payload engine, loaded as a Node addon",
  "license": "MIT",
  "files": [
    "addon.cjs",
    "dist",
    "payload-engine.node"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./addon": "./addon.cjs",
    "./adapter": {
      "import": "./src/adapter/index.ts",
      "types": "./src/adapter/index.ts",
      "default": "./src/adapter/index.ts"
    },
    "./mongodb": {
      "import": "./src/mongo-adapter/index.ts",
      "types": "./src/mongo-adapter/index.ts",
      "default": "./src/mongo-adapter/index.ts"
    },
    "./sqlite": {
      "import": "./src/sqlite/libsql.ts",
      "require": "./src/sqlite/libsql.ts",
      "types": "./src/sqlite/libsql.ts",
      "default": "./src/sqlite/libsql.ts"
    },
    "./shadow": {
      "import": "./src/shadow/index.ts",
      "types": "./src/shadow/index.ts",
      "default": "./src/shadow/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime/index.ts",
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./runtime/hooks": {
      "import": "./src/runtime/hooks.ts",
      "types": "./src/runtime/hooks.ts",
      "default": "./src/runtime/hooks.ts"
    },
    "./compile": {
      "import": "./src/compile/index.ts",
      "types": "./src/compile/index.ts",
      "default": "./src/compile/index.ts"
    },
    "./ops": {
      "import": "./src/ops/index.ts",
      "types": "./src/ops/index.ts",
      "default": "./src/ops/index.ts"
    },
    "./ops-write": {
      "import": "./src/ops-write/index.ts",
      "types": "./src/ops-write/index.ts",
      "default": "./src/ops-write/index.ts"
    },
    "./ops-global": {
      "import": "./src/ops-global/index.ts",
      "types": "./src/ops-global/index.ts",
      "default": "./src/ops-global/index.ts"
    },
    "./query": {
      "import": "./src/query/index.ts",
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./validate": {
      "import": "./src/validate/validations.ts",
      "types": "./src/validate/validations.ts",
      "default": "./src/validate/validations.ts"
    },
    "./validate/native": {
      "import": "./src/validate/native.ts",
      "types": "./src/validate/native.ts",
      "default": "./src/validate/native.ts"
    },
    "./payload-engine.node": "./payload-engine.node",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./addon": "./addon.cjs",
      "./adapter": {
        "import": "./dist/adapter/index.js",
        "default": "./dist/adapter/index.js"
      },
      "./mongodb": {
        "import": "./dist/mongo-adapter/index.js",
        "default": "./dist/mongo-adapter/index.js"
      },
      "./sqlite": {
        "import": "./dist/sqlite/libsql.js",
        "default": "./dist/sqlite/libsql.js"
      },
      "./shadow": {
        "import": "./dist/shadow/index.js",
        "default": "./dist/shadow/index.js"
      },
      "./runtime": {
        "import": "./dist/runtime/index.js",
        "default": "./dist/runtime/index.js"
      },
      "./runtime/hooks": {
        "import": "./dist/runtime/hooks.js",
        "default": "./dist/runtime/hooks.js"
      },
      "./compile": {
        "import": "./dist/compile/index.js",
        "default": "./dist/compile/index.js"
      },
      "./ops": {
        "import": "./dist/ops/index.js",
        "default": "./dist/ops/index.js"
      },
      "./ops-write": {
        "import": "./dist/ops-write/index.js",
        "default": "./dist/ops-write/index.js"
      },
      "./ops-global": {
        "import": "./dist/ops-global/index.js",
        "default": "./dist/ops-global/index.js"
      },
      "./query": {
        "import": "./dist/query/index.js",
        "default": "./dist/query/index.js"
      },
      "./validate": {
        "import": "./dist/validate/validations.js",
        "default": "./dist/validate/validations.js"
      },
      "./validate/native": {
        "import": "./dist/validate/native.js",
        "default": "./dist/validate/native.js"
      },
      "./payload-engine.node": "./payload-engine.node",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node ./scripts/buildDist.mjs",
    "build:native": "node ./scripts/buildNative.mjs",
    "build:native:release": "node ./scripts/buildNative.mjs --release",
    "prepack": "node ./scripts/buildDist.mjs"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "@libsql/client": "0.14.0",
    "@payloadcms/db-mongodb": "workspace:*",
    "@payloadcms/drizzle": "workspace:*",
    "payload": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@payloadcms/db-mongodb": {
      "optional": true
    },
    "@payloadcms/drizzle": {
      "optional": true
    }
  }
}
